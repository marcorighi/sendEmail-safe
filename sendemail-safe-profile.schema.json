{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sendEmail-safe SMTP or Gmail API profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "smtp",
        "gmail_api"
      ]
    },
    "auth": {
      "type": "boolean"
    },
    "ca_file": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "log": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "reply_to": {
      "type": "string"
    },
    "security": {
      "type": "string",
      "enum": [
        "starttls",
        "ssl",
        "plain",
        "auto"
      ]
    },
    "timeout": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "tls_verify": {
      "type": "boolean"
    },
    "user": {
      "type": "string"
    },
    "oauth_client_id": {
      "type": "string",
      "minLength": 1
    },
    "oauth_client_secret": {
      "type": "string"
    },
    "oauth_refresh_token": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "properties": {
        "provider": {
          "enum": [
            "smtp"
          ]
        }
      },
      "required": [
        "auth",
        "from",
        "host",
        "password",
        "port",
        "security",
        "timeout",
        "tls_verify",
        "user"
      ]
    },
    {
      "properties": {
        "provider": {
          "enum": [
            "gmail_api"
          ]
        }
      },
      "required": [
        "provider",
        "from",
        "oauth_client_id",
        "oauth_refresh_token"
      ]
    }
  ]
}
